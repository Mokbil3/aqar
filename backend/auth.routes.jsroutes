import express from "express";

const router = express.Router();

router.post("/register", (req, res) => {
  res.json({
    success: true,
    message: "Register route ready"
  });
});

router.post("/login", (req, res) => {
  res.json({
    success: true,
    message: "Login route ready"
  });
});

export default router;
